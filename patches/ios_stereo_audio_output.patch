diff --git a/sdk/objc/native/src/audio/audio_unit_interface.h b/sdk/objc/native/src/audio/audio_unit_interface.h
new file mode 100644
index 0000000..d1a8ae0
--- /dev/null
+++ b/sdk/objc/native/src/audio/audio_unit_interface.h
@@ -0,0 +1,76 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#ifndef SDK_OBJC_NATIVE_SRC_AUDIO_AUDIO_UNIT_INTERFACE_H_
+#define SDK_OBJC_NATIVE_SRC_AUDIO_AUDIO_UNIT_INTERFACE_H_
+
+#include <AudioUnit/AudioUnit.h>
+
+namespace webrtc {
+namespace ios_adm {
+
+// iOS ADM が扱う AudioUnit ラッパーの抽象基底クラス。
+// VoiceProcessingIO 実装と RemoteIO 実装をランタイムで切り替えるための
+// 共通インタフェースを提供する。
+class AudioUnitInterface {
+ public:
+  // AudioUnit のライフサイクル状態。
+  enum State : int32_t {
+    // Init() を呼ぶ必要がある状態。
+    kInitRequired,
+    // AudioUnit は生成済みだが Initialize() 未実行の状態。
+    kUninitialized,
+    // Initialize() 済みで Start() 待ちの状態。Stop() 直後もここに戻る。
+    kInitialized,
+    // Start() 済みで実際に I/O が走っている状態。
+    kStarted,
+  };
+
+  // 16bit 符号付き整数の 1 サンプルあたりのバイト数。
+  // VoiceProcessingIO / RemoteIO のいずれの実装からも参照するため
+  // interface 側に定数として置く。
+  static const UInt32 kBytesPerSample;
+
+  virtual ~AudioUnitInterface() = default;
+
+  // 実装ごとの AudioUnit インスタンスを生成し、コールバックや
+  // 入出力バスの有効化までの前段設定を行う。
+  virtual bool Init() = 0;
+
+  // 現在の状態を返す。
+  virtual State GetState() const = 0;
+
+  // 与えられたサンプルレートでフォーマットを設定し AudioUnit を初期化する。
+  virtual bool Initialize(Float64 sample_rate) = 0;
+
+  // AudioUnit を開始する。
+  virtual OSStatus Start() = 0;
+
+  // AudioUnit を停止する。
+  virtual bool Stop() = 0;
+
+  // AudioUnit の初期化を解除する。
+  virtual bool Uninitialize() = 0;
+
+  // マイクミュートを設定する。実装によっては no-op となる。
+  virtual bool SetMicrophoneMute(bool enable) = 0;
+
+  // I/O コールバック内から AudioUnitRender を呼ぶための橋渡し。
+  virtual OSStatus Render(AudioUnitRenderActionFlags* flags,
+                          const AudioTimeStamp* time_stamp,
+                          UInt32 output_bus_number,
+                          UInt32 num_frames,
+                          AudioBufferList* io_data) = 0;
+};
+
+}  // namespace ios_adm
+}  // namespace webrtc
+
+#endif  // SDK_OBJC_NATIVE_SRC_AUDIO_AUDIO_UNIT_INTERFACE_H_
