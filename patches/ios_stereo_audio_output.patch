+- (NSInteger)setRecordingPaused:(BOOL)paused {
+  // worker を所有する factory を同期処理の終了まで保持する。
+  // ADM を factory より長く保持しても、破棄済みの worker にはアクセスしない。
+  id __attribute__((objc_precise_lifetime)) factory;
+  webrtc::Thread* worker;
+  @synchronized(self) {
+    factory = _factory;
+    worker = _workerThread;
+  }
+  if (!factory || !worker) {
+    return -1;
+  }
+  auto operation = [ptr = static_cast<webrtc::ios_adm::AudioDeviceModuleIOS*>(_adm.get()), paused] {
+    return paused ? ptr->PauseRecording() : ptr->ResumeRecording();
+  };
+  // 録音の転送と AudioUnit の操作を、初期化・終了と同じ worker で直列化する。
+  return worker->IsCurrent() ? operation() : worker->BlockingCall(operation);
