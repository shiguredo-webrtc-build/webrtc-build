@@ -16,4 +16,21 @@ RTC_OBJC_EXPORT
 // 録音を再開する。内部で AudioDeviceModuleIOS::ResumeRecording() を呼ぶ
 - (NSInteger)resumeRecording;
 
+// iOS 向けステレオ音声出力 (playout) を有効化する。
+// 呼び出し順序: 本メソッドは RTCPeerConnectionFactory に本 ADM を渡す前、
+// かつ ADM 側の InitPlayout の前に呼ぶ必要がある。内部で ADM を Init() 済み
+// でない場合は先に Init() する。
+// スレッド: 本 ADM を生成したスレッドから呼ぶこと。ADM のスレッド制約に従う。
+// 副作用: 有効化により playout は VoiceProcessingIO ではなく RemoteIO 経路に
+// 切り替わり、iOS の AEC / AGC は使えなくなる。AVAudioSession の mode は
+// ステレオ有効時のみ AVAudioSessionModeDefault に一時差し替えされる。
+// 戻り値: 0 が成功、負値が失敗。先行して呼ばれる Init が失敗した場合は Init の
+// 戻り値、それ以外は ADM の SetStereoPlayout 戻り値をそのまま返す。
+- (NSInteger)setStereoPlayoutEnabled:(BOOL)enabled;
+
+// 現在のステレオ playout 有効フラグを取得する。
+// スレッド: 本 ADM を生成したスレッドから呼ぶこと。
+// ADM が未初期化 (Init 未実行) の場合は NO を返す。
+- (BOOL)stereoPlayoutEnabled;
+
 @end
diff --git a/sdk/objc/components/audio/RTCAudioDeviceModule.mm b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
index 30fbcfd..87d3c24 100644
--- a/sdk/objc/components/audio/RTCAudioDeviceModule.mm
+++ b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
@@ -41,4 +41,28 @@ - (NSInteger)resumeRecording {
   return ptr->ResumeRecording();
 }
 
+- (NSInteger)setStereoPlayoutEnabled:(BOOL)enabled {
+  // SetStereoPlayout は ADM 初期化済みが前提のため、未初期化なら
+  // 冪等な Init() で先に初期化する。
+  if (!_adm->Initialized()) {
+    int32_t init_result = _adm->Init();
+    if (init_result != 0) {
+      return init_result;
+    }
+  }
+  return _adm->SetStereoPlayout(enabled);
+}
+
+- (BOOL)stereoPlayoutEnabled {
+  // ADM 未初期化のときは状態を取得できないため NO を返す。
+  if (!_adm->Initialized()) {
+    return NO;
+  }
+  bool enabled = false;
+  if (_adm->StereoPlayout(&enabled) != 0) {
+    return NO;
+  }
+  return enabled ? YES : NO;
+}
+
 @end
