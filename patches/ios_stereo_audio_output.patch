+++ b/sdk/objc/unittests/RTCAudioDeviceModuleThreading_xctest.mm
@@ -0,0 +1,60 @@
+#import <XCTest/XCTest.h>
+
+#import "sdk/objc/api/peerconnection/RTCConfiguration.h"
+#import "sdk/objc/api/peerconnection/RTCMediaConstraints.h"
+#import "sdk/objc/api/peerconnection/RTCPeerConnection.h"
+#import "sdk/objc/api/peerconnection/RTCPeerConnectionFactory+Private.h"
+#import "sdk/objc/components/audio/RTCAudioDeviceModule.h"
+
+@interface RTCAudioDeviceModuleThreadingTests : XCTestCase
+@end
+
+@implementation RTCAudioDeviceModuleThreadingTests
+
+- (void)testRecordingOperationsFollowFactoryLifetime {
+  // 実際の factory と PC を使い、公開 ObjC API から worker へ渡す経路を検証する。
+  // SDP やトラックを設定しないため、AudioUnit の入出力は開始しない。
+  RTC_OBJC_TYPE(RTCAudioDeviceModule)* module = [[RTC_OBJC_TYPE(RTCAudioDeviceModule) alloc] init];
+  XCTAssertEqual(-1, [module resumeRecording], @"factory へ渡す前は解除要求を拒否すること");
+  __weak RTC_OBJC_TYPE(RTCPeerConnectionFactory)* releasedFactory;
+  @autoreleasepool {
+    RTC_OBJC_TYPE(RTCPeerConnectionFactory)* factory =
+        [[RTC_OBJC_TYPE(RTCPeerConnectionFactory) alloc] initWithEncoderFactory:nil
+                                                               decoderFactory:nil
+                                                            audioDeviceModule:module];
+    XCTAssertNotNil(factory, @"実際の factory を生成できること");
+    if (!factory) return;
+    releasedFactory = factory;
+    XCTAssertNil([[RTC_OBJC_TYPE(RTCPeerConnectionFactory) alloc] initWithEncoderFactory:nil
+                                                                        decoderFactory:nil
+                                                                     audioDeviceModule:module],
+                 @"同じ ADM を別の worker へ二重に渡さないこと");
+    for (int iteration = 0; iteration < 2; ++iteration) {
+      @autoreleasepool {
+        RTC_OBJC_TYPE(RTCPeerConnection)* peer =
+            [factory peerConnectionWithConfiguration:[[RTC_OBJC_TYPE(RTCConfiguration) alloc] init]
+                                         constraints:[[RTC_OBJC_TYPE(RTCMediaConstraints) alloc]
+                                                         initWithMandatoryConstraints:nil
+                                                                  optionalConstraints:nil]
+                                            delegate:nil];
+        XCTAssertNotNil(peer, @"PC の生成で media engine と ADM を初期化できること");
+        // worker 以外から呼んでも AudioDeviceIOS と AudioDeviceBuffer のスレッド制約を守る。
+        XCTAssertEqual(0, [module pauseRecording], @"アプリ側から worker で停止を実行できること");
+        XCTAssertEqual(0, [module resumeRecording], @"アプリ側から worker で再開を実行できること");
+        factory.workerThread->BlockingCall([&] {
+          XCTAssertEqual(0, [module pauseRecording], @"同じ worker では同期呼び出しで待ち合わないこと");
+          XCTAssertEqual(0, [module resumeRecording], @"同じ worker から再開できること");
+        });
+        [peer close];
+      }
+      // 最後の PC を解放して ADM が終了しても、同じ factory の次の PC で再初期化できる。
+      factory.signalingThread->BlockingCall([] {});
+      XCTAssertEqual(-1, [module resumeRecording], @"最後の PC 解放後は ADM が終了していること");
+    }
+  }
+  XCTAssertNil(releasedFactory, @"ObjC ADM が factory を循環参照しないこと");
+  XCTAssertEqual(-1, [module pauseRecording], @"factory 終了後の停止要求を拒否すること");
+  XCTAssertEqual(-1, [module resumeRecording], @"factory 終了後の解除要求を拒否すること");
+}
+
+@end
