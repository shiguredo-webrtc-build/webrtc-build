+bool VoiceProcessingAudioUnit::GetMicrophoneMute(bool& enabled) const {
+  if (!input_initialized_) return false;
+  UInt32 input_enabled = 0;
+  UInt32 size = sizeof(input_enabled);
+  OSStatus result = AudioUnitGetProperty(
+      vpio_unit_, kAudioOutputUnitProperty_EnableIO, kAudioUnitScope_Input,
