+// ユーザーのコールバックで worker の破棄や再入が起きないよう、メインキューに通知する。
+- (void)notifyInputCompletion:(void (^)(NSError *_Nullable))completion
+                       error:(NSError *_Nullable)error {
+  if (completion) {
+    dispatch_async(dispatch_get_main_queue(), ^{ completion(error); });
+  }
+}
+
+- (NSError *)inputInitializationError {
+  return [NSError errorWithDomain:kRTCAudioSessionErrorDomain
+                            code:kRTCAudioSessionErrorInputInitialization
+                        userInfo:nil];
+}
+
+// 保留中の入力要求を取り出す。要求が無ければ NO を返す。
+- (BOOL)takePendingInputRequestWithInitialMute:(BOOL *)initialMute {
+  @synchronized(self) {
+    if (!_waitsInputInit) return NO;
+    *initialMute = _initialMicrophoneMute;
+    return YES;
+  }
+}
+
+- (void)finishInputInitializationWithError:(NSError *_Nullable)error {
+  void (^completion)(NSError *) = nil;
+  @synchronized(self) {
+    _waitsInputInit = NO;
+    _isInputInited = error == nil;
+    completion = _inputInitCompletionHandler;
+    _inputInitCompletionHandler = nil;
+  }
+  [self notifyInputCompletion:completion error:error];
+}
+
+- (void)discardInputInitialization {
+  void (^cancelled)(NSError *) = nil;
+  @synchronized(self) {
+    cancelled = _inputInitCompletionHandler;
+    _inputInitCompletionHandler = nil;
+    _waitsInputInit = NO;
+    _isInputInited = NO;
+  }
+  [self notifyInputCompletion:cancelled error:[self inputInitializationError]];
+}
+
+- (void)initializeInput:(void (^)(NSError *_Nullable))completionHandler {
+  BOOL duplicate;
+  @synchronized(self) {
+    duplicate = _isInputInited || _waitsInputInit;
+    if (!duplicate) {
+      _inputInitCompletionHandler = [completionHandler copy];
+      _waitsInputInit = YES;
+    }
+  }
+  if (duplicate) {
+    [self notifyInputCompletion:completionHandler error:[self inputInitializationError]];
+  }
+}
+
+- (BOOL)setInitialMicrophoneMute:(BOOL)initialMicrophoneMute {
+  @synchronized(self) {
+    if (_isInputInited) return NO;
+    _initialMicrophoneMute = initialMicrophoneMute;
+    return YES;
+  }
+}
+
 @end
