+++ b/sdk/objc/native/src/audio/remote_io_audio_unit.h
@@ -0,0 +1,60 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#ifndef SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
+#define SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
+
+#include "voice_processing_audio_unit.h"
+
+namespace webrtc {
+namespace ios_adm {
+
+// VoiceProcessingAudioUnit と同じ観測インタフェース
+// (VoiceProcessingAudioUnitObserver) を共有しつつ、componentSubType に
+// kAudioUnitSubType_RemoteIO を用いる AudioUnit ラッパー。iOS の
+// VoiceProcessingIO はステレオ playout を成立させられないため、
+// ステレオ出力有効時のみ本クラスを利用する。
+//
+// 注: 本ユニットはハードウェア AEC / AGC を提供しない。
+class RemoteIOAudioUnit : public VoiceProcessingAudioUnit {
+ public:
+  // AudioUnit 生成時に playout / recording のチャンネル数を確定させる。
+  // 生成後に SetStereoPlayout でチャンネル数を変えたい場合、ADM 側で
+  // AudioUnit を作り直す運用にする (本パッチの CreateAudioUnit 経路)。
+  RemoteIOAudioUnit(VoiceProcessingAudioUnitObserver* observer,
+                    UInt32 play_channels,
+                    UInt32 rec_channels);
+  ~RemoteIOAudioUnit() override;
+
+  // Remote I/O AudioUnit を生成し、入力/出力両方の bus とコールバックを
+  // 配線する。入力側の EnableIO と SetInputCallback を必ず設定するため、
+  // playout stereo 時でも recording 経路は正しく動作する。
+  bool Init() override;
+
+  // 与えられた sample_rate で AudioUnit を初期化する。stream format には
+  // 入力側に rec_channels_、出力側に play_channels_ を反映する。
+  bool Initialize(Float64 sample_rate) override;
+
+ protected:
+  // channels を明示指定できる GetFormat のオーバーロード。
+  // 親クラスの GetFormat(Float64) とはシグネチャが異なるため、
+  // 実質的には新規メソッドとして扱われる。
+  AudioStreamBasicDescription GetFormat(Float64 sample_rate,
+                                        UInt32 channels) const;
+
+  // playout / recording のチャンネル数。生成時に確定し、以降は変更しない。
+  const UInt32 play_channels_;
+  const UInt32 rec_channels_;
+};
+
+}  // namespace ios_adm
+}  // namespace webrtc
+
+#endif  // SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
diff --git a/sdk/objc/native/src/audio/remote_io_audio_unit.mm b/sdk/objc/native/src/audio/remote_io_audio_unit.mm
new file mode 100644
index 0000000000..c3f6a32bd3
--- /dev/null
+++ b/sdk/objc/native/src/audio/remote_io_audio_unit.mm
@@ -0,0 +1,252 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "remote_io_audio_unit.h"
+
+#include "rtc_base/checks.h"
+
+#import "base/RTCLogging.h"
+
+namespace webrtc {
+namespace ios_adm {
+
+// AudioUnitInitialize() は連続呼び出しで一時失敗することがあるため、
+// 短いスリープを挟んで再試行する。上限回数は VoiceProcessingAudioUnit と揃える。
+static const int kMaxNumberOfAudioUnitInitializeAttempts = 5;
+// Remote I/O ユニットの bus 1 は入力ハードウェア (マイク) に接続される。
+static const AudioUnitElement kInputBus = 1;
+// Remote I/O ユニットの bus 0 は出力ハードウェア (スピーカー) に接続される。
+static const AudioUnitElement kOutputBus = 0;
+
+RemoteIOAudioUnit::RemoteIOAudioUnit(
+    VoiceProcessingAudioUnitObserver* observer,
+    UInt32 play_channels,
+    UInt32 rec_channels)
+    // 親クラスの構築子。bypass_voice_processing / detect_mute_speech は
+    // Remote I/O では意味を持たないため false 固定で渡す。
+    : VoiceProcessingAudioUnit(false, false, observer),
+      play_channels_(play_channels),
+      rec_channels_(rec_channels) {
+  RTC_DCHECK_GT(play_channels_, 0u);
+  RTC_DCHECK_GT(rec_channels_, 0u);
+}
+
+RemoteIOAudioUnit::~RemoteIOAudioUnit() {
+  // 実質のクリーンアップは親クラスのデストラクタ (DisposeAudioUnit) が
+  // 行うため、ここでは追加処理は無い。デストラクタ本体を .mm 側にも
+  // 定義しておかないと未定義シンボルでリンクエラーになるため、
+  // 空実装であっても必ずここに置く。
+}
+
+bool RemoteIOAudioUnit::Init() {
+  RTC_DCHECK_EQ(state_, kInitRequired);
+
+  // Remote I/O AudioUnit のコンポーネント記述を作成する。
+  AudioComponentDescription rio_unit_description;
+  rio_unit_description.componentType = kAudioUnitType_Output;
+  rio_unit_description.componentSubType = kAudioUnitSubType_RemoteIO;
+  rio_unit_description.componentManufacturer = kAudioUnitManufacturer_Apple;
+  rio_unit_description.componentFlags = 0;
+  rio_unit_description.componentFlagsMask = 0;
+
+  // 記述にマッチする AudioComponent を取得する。
+  AudioComponent found_rio_unit_ref =
+      AudioComponentFindNext(nullptr, &rio_unit_description);
+
+  // Remote I/O AudioUnit のインスタンスを生成する。
+  OSStatus result = noErr;
+  result = AudioComponentInstanceNew(found_rio_unit_ref, &vpio_unit_);
+  if (result != noErr) {
+    vpio_unit_ = nullptr;
+    RTCLogError(@"AudioComponentInstanceNew failed. Error=%ld.", (long)result);
+    return false;
+  }
+
+  // 入力側の bus (マイク) を有効化する。playout stereo 時でも
+  // recording 経路を壊さないため、VoiceProcessingAudioUnit と同じ配線を行う。
+  UInt32 enable_input = 1;
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Input,
+                                kInputBus,
+                                &enable_input,
+                                sizeof(enable_input));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to enable input on input scope of input element. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 出力側の bus (スピーカー) を有効化する。
+  UInt32 enable_output = 1;
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Output,
+                                kOutputBus,
+                                &enable_output,
+                                sizeof(enable_output));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to enable output on output scope of output element. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // playout 用の render コールバックを登録する。
+  AURenderCallbackStruct render_callback;
+  render_callback.inputProc = OnGetPlayoutData;
+  render_callback.inputProcRefCon = this;
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioUnitProperty_SetRenderCallback,
+                                kAudioUnitScope_Input,
+                                kOutputBus,
+                                &render_callback,
+                                sizeof(render_callback));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to specify the render callback on the output bus. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 入力バッファは自前で確保するため AudioUnit 側の確保を無効化する。
+  UInt32 flag = 0;
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioUnitProperty_ShouldAllocateBuffer,
+                                kAudioUnitScope_Output,
+                                kInputBus,
+                                &flag,
+                                sizeof(flag));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to disable buffer allocation on the input bus. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // recording 側のコールバックを登録する。これを忘れると OnDeliverRecordedData
+  // が呼ばれず recording が空回りするので、Remote I/O 側でも必ず設定する。
+  AURenderCallbackStruct input_callback;
+  input_callback.inputProc = OnDeliverRecordedData;
+  input_callback.inputProcRefCon = this;
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioOutputUnitProperty_SetInputCallback,
+                                kAudioUnitScope_Global,
+                                kInputBus,
+                                &input_callback,
+                                sizeof(input_callback));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to specify the input callback on the input bus. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  state_ = kUninitialized;
+  return true;
+}
+
+bool RemoteIOAudioUnit::Initialize(Float64 sample_rate) {
+  RTC_DCHECK_GE(state_, kUninitialized);
+  RTCLog(@"Initializing Remote I/O audio unit with sample rate: %f, "
+          "play_channels=%u, rec_channels=%u",
+         sample_rate,
+         static_cast<unsigned int>(play_channels_),
+         static_cast<unsigned int>(rec_channels_));
+
+  OSStatus result = noErr;
+  UInt32 size = sizeof(AudioStreamBasicDescription);
+
+  // 入力側 bus (マイク) に recording 用フォーマットを設定する。
+  // kAudioUnitScope_Output + kInputBus は "AudioUnit の入力 element から
+  // 外部へ流す stream" のフォーマット指定なので、ここには recording 側の
+  // チャンネル数 (rec_channels_) を渡すのが正しい配線。
+  AudioStreamBasicDescription in_format = GetFormat(sample_rate, rec_channels_);
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioUnitProperty_StreamFormat,
+                                kAudioUnitScope_Output,
+                                kInputBus,
+                                &in_format,
+                                size);
+  if (result != noErr) {
+    RTCLogError(@"Failed to set format on output scope of input bus. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 出力側 bus (スピーカー) に playout 用フォーマットを設定する。
+  // kAudioUnitScope_Input + kOutputBus は "AudioUnit の出力 element へ
+  // 外部から流し込む stream" のフォーマット指定なので、ここには playout 側の
+  // チャンネル数 (play_channels_) を渡す。
+  AudioStreamBasicDescription out_format =
+      GetFormat(sample_rate, play_channels_);
+  result = AudioUnitSetProperty(vpio_unit_,
+                                kAudioUnitProperty_StreamFormat,
+                                kAudioUnitScope_Input,
+                                kOutputBus,
+                                &out_format,
+                                size);
+  if (result != noErr) {
+    RTCLogError(@"Failed to set format on input scope of output bus. "
+                 "Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // AudioUnitInitialize は連続呼び出しで一時失敗することがある。
+  // See webrtc:5166 for details.
+  int failed_initalize_attempts = 0;
+  result = AudioUnitInitialize(vpio_unit_);
+  while (result != noErr) {
+    RTCLogError(@"Failed to initialize the Remote I/O audio unit. "
+                 "Error=%ld.",
+                (long)result);
+    ++failed_initalize_attempts;
+    if (failed_initalize_attempts == kMaxNumberOfAudioUnitInitializeAttempts) {
+      RTCLogError(@"Too many initialization attempts.");
+      return false;
+    }
+    RTCLog(@"Pause 100ms and try audio unit initialization again...");
+    [NSThread sleepForTimeInterval:0.1f];
+    result = AudioUnitInitialize(vpio_unit_);
+  }
+  RTCLog(@"Remote I/O audio unit is now initialized.");
+
+  state_ = kInitialized;
+  return true;
+}
+
+AudioStreamBasicDescription RemoteIOAudioUnit::GetFormat(
+    Float64 sample_rate, UInt32 channels) const {
+  // Remote I/O 用 stream format。interleaved 16 bit PCM。
+  // playout がステレオの場合、mChannelsPerFrame は 2 になり、
+  // mBytesPerPacket / mBytesPerFrame も 2 倍する必要がある。
+  AudioStreamBasicDescription format;
+  format.mSampleRate = sample_rate;
+  format.mFormatID = kAudioFormatLinearPCM;
+  format.mFormatFlags =
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+  format.mFramesPerPacket = 1;
+  format.mChannelsPerFrame = channels;
+  format.mBytesPerPacket = kBytesPerSample * channels;
+  format.mBytesPerFrame = kBytesPerSample * channels;
+  format.mBitsPerChannel = 8 * kBytesPerSample;
+  return format;
+}
+
+}  // namespace ios_adm
+}  // namespace webrtc
