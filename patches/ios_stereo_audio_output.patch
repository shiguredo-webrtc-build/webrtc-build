+- (void)checkSendOnlyStartBeforeRequest:(BOOL)started {
+  [self createDeviceWithStereo:YES input:YES];
+  [self runOnWorker:^{
+    XCTAssertEqual(0, self->_device->InitRecording(), @"送信専用の AudioUnit を初期化できること");
+    if (started) XCTAssertEqual(0, self->_device->StartRecording(), @"録音を開始できること");
+  }];
+  XCTestExpectation* completed = [self expectationWithDescription:@"送信専用の入力要求が完了すること"];
+  [[RTC_OBJC_TYPE(RTCAudioSession) sharedInstance] initializeInput:^(NSError* error) {
+    XCTAssertNil(error, @"送信専用でも入力初期化が成功すること");
+    [completed fulfill];
+  }];
+  [self waitForExpectations:@[completed] timeout:10];
+  [self runOnWorker:^{
+    if (!started) {
+      XCTAssertFalse(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                     @"入力初期化だけでは AudioUnit を開始しないこと");
+      XCTAssertFalse(self->_device->Recording(), @"入力初期化だけでは録音を開始しないこと");
+      XCTAssertEqual(0, self->_device->PauseRecording(), @"録音開始前もミュートを設定できること");
+      XCTAssertFalse(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                     @"停止要求では未開始の AudioUnit を開始しないこと");
+      XCTAssertEqual(0u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, true),
+                     @"録音開始前のミュートで入力 I/O を無効にすること");
+      XCTAssertEqual(0, self->_device->StartRecording(), @"入力初期化後に録音を開始できること");
+      XCTAssertEqual(0, self->_device->ResumeRecording(), @"録音開始前に指定したミュートを解除できること");
+    }
+    XCTAssertFalse(self->_device->Playing(), @"送信専用で再生の論理状態を変更しないこと");
+    XCTAssertTrue(self->_device->Recording(), @"録音を継続すること");
+    XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                  @"送信専用の AudioUnit を再開すること");
+    XCTAssertEqual(1u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, true),
+                   @"マイク入力が有効であること");
+  }];
+}
