@@ -0,0 +1,424 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "remote_io_audio_unit.h"
+
+#include "rtc_base/checks.h"
+
+#import "base/RTCLogging.h"
+
+namespace webrtc {
+namespace ios_adm {
+
+// AudioUnitInitialize がまれに一時失敗するので、短い sleep を挟んで
+// リトライする回数の上限。
+static const int kMaxNumberOfAudioUnitInitializeAttempts = 5;
+// RemoteIO の入力バス (マイク) は 1 に固定されている。
+static const AudioUnitElement kInputBus = 1;
+// RemoteIO の出力バス (スピーカ) は 0 に固定されている。
+static const AudioUnitElement kOutputBus = 0;
+
+RemoteIOAudioUnit::RemoteIOAudioUnit(
+    VoiceProcessingAudioUnitObserver* observer,
+    UInt32 play_channels,
+    UInt32 rec_channels)
+    : observer_(observer),
+      play_channels_(play_channels),
+      rec_channels_(rec_channels),
+      rio_unit_(nullptr),
+      state_(AudioUnitInterface::kInitRequired) {
+  RTC_DCHECK(observer);
+  RTC_DCHECK_GT(play_channels, 0u);
+  RTC_DCHECK_GT(rec_channels, 0u);
+}
+
+RemoteIOAudioUnit::~RemoteIOAudioUnit() {
+  // 破棄時に AudioUnit を必ず解放する。
+  DisposeAudioUnit();
+}
+
+bool RemoteIOAudioUnit::Init() {
+  RTC_DCHECK_EQ(state_, AudioUnitInterface::kInitRequired);
+
+  // Remote I/O audio unit を識別する AudioComponentDescription を用意する。
+  AudioComponentDescription rio_unit_description;
+  rio_unit_description.componentType = kAudioUnitType_Output;
+  rio_unit_description.componentSubType = kAudioUnitSubType_RemoteIO;
+  rio_unit_description.componentManufacturer = kAudioUnitManufacturer_Apple;
+  rio_unit_description.componentFlags = 0;
+  rio_unit_description.componentFlagsMask = 0;
+
+  // 記述に一致する AudioComponent を検索する。
+  AudioComponent found_rio_unit_ref =
+      AudioComponentFindNext(nullptr, &rio_unit_description);
+
+  // Remote I/O audio unit のインスタンスを生成する。
+  OSStatus result = noErr;
+  result = AudioComponentInstanceNew(found_rio_unit_ref, &rio_unit_);
+  if (result != noErr) {
+    rio_unit_ = nullptr;
+    RTCLogError(@"AudioComponentInstanceNew failed for RemoteIO. Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 明示的な initializeInput の要求が来るまではマイクを使用しない。
+  UInt32 enable_input = 0;
+  result = AudioUnitSetProperty(rio_unit_,
+                                kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Input,
+                                kInputBus,
+                                &enable_input,
+                                sizeof(enable_input));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to disable input on input scope of input element for "
+                 "RemoteIO. Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 出力バスの出力スコープで出力 (スピーカ) を有効化する。
+  UInt32 enable_output = 1;
+  result = AudioUnitSetProperty(rio_unit_,
+                                kAudioOutputUnitProperty_EnableIO,
+                                kAudioUnitScope_Output,
+                                kOutputBus,
+                                &enable_output,
+                                sizeof(enable_output));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to enable output on output scope of output element "
+                 "for RemoteIO. Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // 出力バスに render callback を登録する。playout データはこの callback で
+  // 供給される。
+  AURenderCallbackStruct render_callback;
+  render_callback.inputProc = OnGetPlayoutData;
+  render_callback.inputProcRefCon = this;
+  result = AudioUnitSetProperty(rio_unit_,
+                                kAudioUnitProperty_SetRenderCallback,
+                                kAudioUnitScope_Input,
+                                kOutputBus,
+                                &render_callback,
+                                sizeof(render_callback));
+  if (result != noErr) {
+    DisposeAudioUnit();
+    RTCLogError(@"Failed to specify the render callback on the output bus for "
+                 "RemoteIO. Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  state_ = AudioUnitInterface::kUninitialized;
+  return true;
+}
+
+AudioUnitInterface::State RemoteIOAudioUnit::GetState() const {
+  return state_;
+}
+
+bool RemoteIOAudioUnit::InitializeInput(bool initial_mute) {
+  RTC_DCHECK_EQ(state_, kUninitialized);
+  if (state_ != kUninitialized || input_initialized_) {
+    return false;
+  }
+  // 入力の準備が完了してから EnableIO を変更し、途中の失敗では入力を開始しない。
+  UInt32 allocate_buffer = 0;
+  OSStatus result = AudioUnitSetProperty(
+      rio_unit_, kAudioUnitProperty_ShouldAllocateBuffer,
+      kAudioUnitScope_Output, kInputBus, &allocate_buffer,
+      sizeof(allocate_buffer));
+  if (result != noErr) {
+    RTCLogError(@"Failed to configure input buffer. Error=%ld", (long)result);
+    return false;
+  }
+  AURenderCallbackStruct callback = {OnDeliverRecordedData, this};
+  result = AudioUnitSetProperty(
+      rio_unit_, kAudioOutputUnitProperty_SetInputCallback,
+      kAudioUnitScope_Global, kInputBus, &callback, sizeof(callback));
+  if (result != noErr) {
+    RTCLogError(@"Failed to configure input callback. Error=%ld", (long)result);
+    return false;
+  }
+  UInt32 enable_input = initial_mute ? 0 : 1;
+  result = AudioUnitSetProperty(
+      rio_unit_, kAudioOutputUnitProperty_EnableIO,
+      kAudioUnitScope_Input, kInputBus, &enable_input, sizeof(enable_input));
+  if (result != noErr) {
+    RTCLogError(@"Failed to configure input IO. Error=%ld", (long)result);
+    return false;
+  }
+  input_initialized_ = true;
+  return true;
+}
+
+bool RemoteIOAudioUnit::Initialize(Float64 sample_rate) {
+  RTC_DCHECK_GE(state_, AudioUnitInterface::kUninitialized);
+  RTCLog(@"Initializing RemoteIO audio unit with sample rate: %f", sample_rate);
+
+  OSStatus result = noErr;
+
+  if (input_initialized_) {
+    // 入力側 (マイク) のフォーマット。入力バスの出力スコープに設定する。
+    // channels は record 側で決定する。
+    AudioStreamBasicDescription input_format =
+        GetFormat(sample_rate, rec_channels_);
+    UInt32 size = sizeof(input_format);
+    result = AudioUnitSetProperty(rio_unit_,
+                                  kAudioUnitProperty_StreamFormat,
+                                  kAudioUnitScope_Output,
+                                  kInputBus,
+                                  &input_format,
+                                  size);
+    if (result != noErr) {
+      RTCLogError(@"Failed to set format on output scope of input bus for "
+                   "RemoteIO. Error=%ld.",
+                  (long)result);
+      return false;
+    }
+
+  }
+
+  // 出力側 (スピーカ) のフォーマット。出力バスの入力スコープに設定する。
+  // channels は playout 側で決定する。ステレオ出力有効時はここが 2 になる。
+  AudioStreamBasicDescription output_format =
+      GetFormat(sample_rate, play_channels_);
+  UInt32 size = sizeof(output_format);
+  result = AudioUnitSetProperty(rio_unit_,
+                                kAudioUnitProperty_StreamFormat,
+                                kAudioUnitScope_Input,
+                                kOutputBus,
+                                &output_format,
+                                size);
+  if (result != noErr) {
+    RTCLogError(@"Failed to set format on input scope of output bus for "
+                 "RemoteIO. Error=%ld.",
+                (long)result);
+    return false;
+  }
+
+  // AudioUnitInitialize は連続呼び出しで一時的に失敗することがあるため、
+  // 短い sleep を挟んで最大 kMaxNumberOfAudioUnitInitializeAttempts 回リトライ
+  // する。
+  int failed_initialize_attempts = 0;
+  result = AudioUnitInitialize(rio_unit_);
+  while (result != noErr) {
+    RTCLogError(@"Failed to initialize the RemoteIO audio unit. Error=%ld.",
+                (long)result);
+    ++failed_initialize_attempts;
+    if (failed_initialize_attempts == kMaxNumberOfAudioUnitInitializeAttempts) {
+      RTCLogError(@"Too many initialization attempts for RemoteIO.");
+      return false;
+    }
+    RTCLog(@"Pause 100ms and try RemoteIO audio unit initialization again...");
+    [NSThread sleepForTimeInterval:0.1f];
+    result = AudioUnitInitialize(rio_unit_);
+  }
+  RTCLog(@"RemoteIO audio unit is now initialized.");
+
+  state_ = AudioUnitInterface::kInitialized;
+  return true;
+}
+
+OSStatus RemoteIOAudioUnit::Start() {
+  RTC_DCHECK_GE(state_, AudioUnitInterface::kUninitialized);
+  RTCLog(@"Starting RemoteIO audio unit.");
+
+  OSStatus result = AudioOutputUnitStart(rio_unit_);
+  if (result != noErr) {
+    RTCLogError(@"Failed to start RemoteIO audio unit. Error=%ld",
+                (long)result);
+    return result;
+  }
+  RTCLog(@"Started RemoteIO audio unit");
+  state_ = AudioUnitInterface::kStarted;
+  return noErr;
+}
+
+bool RemoteIOAudioUnit::Stop() {
+  RTC_DCHECK_GE(state_, AudioUnitInterface::kUninitialized);
+  RTCLog(@"Stopping RemoteIO audio unit.");
+
+  OSStatus result = AudioOutputUnitStop(rio_unit_);
+  if (result != noErr) {
+    RTCLogError(@"Failed to stop RemoteIO audio unit. Error=%ld",
+                (long)result);
+    return false;
+  }
+  RTCLog(@"Stopped RemoteIO audio unit");
+  state_ = AudioUnitInterface::kInitialized;
+  return true;
+}
+
+bool RemoteIOAudioUnit::Uninitialize() {
+  RTC_DCHECK_GE(state_, AudioUnitInterface::kUninitialized);
+  RTCLog(@"Unintializing RemoteIO audio unit.");
+
+  OSStatus result = AudioUnitUninitialize(rio_unit_);
+  if (result != noErr) {
+    RTCLogError(@"Failed to uninitialize RemoteIO audio unit. Error=%ld",
+                (long)result);
+    return false;
+  }
+  RTCLog(@"Uninitialized RemoteIO audio unit.");
+  state_ = AudioUnitInterface::kUninitialized;
+  return true;
+}
+
+bool RemoteIOAudioUnit::SetMicrophoneMute(bool enable) {
+  // initializeInput なしのミュート解除でマイクを接続しない。
+  if (!input_initialized_) return false;
+  RTC_DCHECK_GE(state_, AudioUnitInterface::kUninitialized);
+
+  // VoiceProcessing 固有の MuteOutput ではなく、入力 I/O を無効化して捕捉を止める。
+  // pause / resume 経路では Stop / Uninitialize 後に設定し、出力 I/O は変更しない。
+  UInt32 enable_input = enable ? 0 : 1;
+  OSStatus result = AudioUnitSetProperty(rio_unit_,
+                                        kAudioOutputUnitProperty_EnableIO,
+                                        kAudioUnitScope_Input,
+                                        kInputBus,
+                                        &enable_input,
+                                        sizeof(enable_input));
+  if (result != noErr) {
+    RTCLogError(@"Failed to %s RemoteIO microphone. OSStatus=%ld.",
+                enable ? "mute" : "unmute",
+                (long)result);
+    return false;
+  }
+  return true;
+}
+
+bool RemoteIOAudioUnit::GetMicrophoneMute(bool& enabled) const {
+  if (!input_initialized_) return false;
+  UInt32 input_enabled = 0;
+  UInt32 size = sizeof(input_enabled);
+  OSStatus result = AudioUnitGetProperty(
+      rio_unit_, kAudioOutputUnitProperty_EnableIO, kAudioUnitScope_Input,
+      kInputBus, &input_enabled, &size);
+  if (result != noErr) {
+    RTCLogError(@"Failed to get RemoteIO microphone state. OSStatus=%ld.", (long)result);
+    return false;
+  }
+  enabled = input_enabled == 0;
+  return true;
+}
+
+OSStatus RemoteIOAudioUnit::Render(AudioUnitRenderActionFlags* flags,
+                                   const AudioTimeStamp* time_stamp,
+                                   UInt32 output_bus_number,
+                                   UInt32 num_frames,
+                                   AudioBufferList* io_data) {
+  RTC_DCHECK(rio_unit_) << "Init() not called.";
+
+  OSStatus result = AudioUnitRender(
+      rio_unit_, flags, time_stamp, output_bus_number, num_frames, io_data);
+  if (result != noErr) {
+    RTCLogError(@"Failed to render RemoteIO audio unit. Error=%ld",
+                (long)result);
+  }
+  return result;
+}
+
+OSStatus RemoteIOAudioUnit::OnGetPlayoutData(
+    void* in_ref_con,
+    AudioUnitRenderActionFlags* flags,
+    const AudioTimeStamp* time_stamp,
+    UInt32 bus_number,
+    UInt32 num_frames,
+    AudioBufferList* io_data) {
+  RemoteIOAudioUnit* audio_unit =
+      static_cast<RemoteIOAudioUnit*>(in_ref_con);
+  return audio_unit->NotifyGetPlayoutData(
+      flags, time_stamp, bus_number, num_frames, io_data);
+}
+
+OSStatus RemoteIOAudioUnit::OnDeliverRecordedData(
+    void* in_ref_con,
+    AudioUnitRenderActionFlags* flags,
+    const AudioTimeStamp* time_stamp,
+    UInt32 bus_number,
+    UInt32 num_frames,
+    AudioBufferList* io_data) {
+  RemoteIOAudioUnit* audio_unit =
+      static_cast<RemoteIOAudioUnit*>(in_ref_con);
+  return audio_unit->NotifyDeliverRecordedData(
+      flags, time_stamp, bus_number, num_frames, io_data);
+}
+
+OSStatus RemoteIOAudioUnit::NotifyGetPlayoutData(
+    AudioUnitRenderActionFlags* flags,
+    const AudioTimeStamp* time_stamp,
+    UInt32 bus_number,
+    UInt32 num_frames,
+    AudioBufferList* io_data) {
+  return observer_->OnGetPlayoutData(
+      flags, time_stamp, bus_number, num_frames, io_data);
+}
+
+OSStatus RemoteIOAudioUnit::NotifyDeliverRecordedData(
+    AudioUnitRenderActionFlags* flags,
+    const AudioTimeStamp* time_stamp,
+    UInt32 bus_number,
+    UInt32 num_frames,
+    AudioBufferList* io_data) {
+  return observer_->OnDeliverRecordedData(
+      flags, time_stamp, bus_number, num_frames, io_data);
+}
+
+AudioStreamBasicDescription RemoteIOAudioUnit::GetFormat(
+    Float64 sample_rate,
+    UInt32 channels) const {
+  // 入出力で個別のチャンネル数を持てるようにするため、channels を引数で受ける。
+  // ステレオ playout 有効時は出力側で channels=2 を渡す。
+  AudioStreamBasicDescription format;
+  format.mSampleRate = sample_rate;
+  format.mFormatID = kAudioFormatLinearPCM;
+  format.mFormatFlags =
+      kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+  format.mBytesPerPacket = AudioUnitInterface::kBytesPerSample * channels;
+  format.mFramesPerPacket = 1;  // uncompressed
+  format.mBytesPerFrame = AudioUnitInterface::kBytesPerSample * channels;
+  format.mChannelsPerFrame = channels;
+  format.mBitsPerChannel = 8 * AudioUnitInterface::kBytesPerSample;
+  format.mReserved = 0;
+  return format;
+}
+
+void RemoteIOAudioUnit::DisposeAudioUnit() {
+  if (rio_unit_) {
+    switch (state_) {
+      case AudioUnitInterface::kStarted:
+        Stop();
+        [[fallthrough]];
+      case AudioUnitInterface::kInitialized:
+        Uninitialize();
+        break;
+      case AudioUnitInterface::kUninitialized:
+      case AudioUnitInterface::kInitRequired:
+        break;
+    }
+
+    RTCLog(@"Disposing RemoteIO audio unit.");
+    OSStatus result = AudioComponentInstanceDispose(rio_unit_);
+    if (result != noErr) {
+      RTCLogError(@"AudioComponentInstanceDispose failed for RemoteIO. "
+                   "Error=%ld.",
+                  (long)result);
+    }
+    rio_unit_ = nullptr;
+  }
+}
+
