+    // アプリのスレッドでは呼ばず、未初期化の ADM に設定値だけを渡す。
+    int32_t result = _adm->SetStereoPlayout(enabled);
+    if (result == 0) {
+      _stereoPlayoutEnabled = enabled;
+    }
+    return result;
+  }
+}
