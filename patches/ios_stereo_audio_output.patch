@@ -16,4 +16,29 @@ RTC_OBJC_EXPORT
 // 録音を再開する。内部で AudioDeviceModuleIOS::ResumeRecording() を呼ぶ
 - (NSInteger)resumeRecording;

+// iOS のステレオ出力 (playout) を有効化する。内部で
+// AudioDeviceModuleIOS::SetStereoPlayout() を呼ぶ。
+// 呼び出し順序の制約:
+//   本メソッドは RTCPeerConnectionFactory に本 ADM を渡す前、
+//   すなわち InitPlayout / StartPlayout の前に呼ぶこと。
+//   InitPlayout 後に呼ぶと ADM 側で -1 を返し、設定は反映されない。
+// スレッド制約:
+//   本 ADM を生成したスレッドから呼ぶこと。別スレッドから呼ぶと
+//   内部の RTC_DCHECK_RUN_ON により Debug ビルドが停止する。
+// 副作用:
+//   ADM が未初期化の場合、本メソッドが内部で AudioDeviceModule::Init() を
+//   先行して呼ぶ (Init は冪等なので PeerConnectionFactory が再度呼んでも問題ない)。
+//   ステレオ有効時は VoiceProcessingIO ではなく RemoteIO を使うため、
+//   ハードウェアの AEC / AGC が無効になる。
+//   AVAudioSession のモードもステレオ有効時のみ VoiceChat から
+//   Default に切り替わる。
+// 戻り値:
+//   0 で成功、その他はネイティブ ADM が返したエラーコード。
+- (NSInteger)setStereoPlayoutEnabled:(BOOL)enabled;
+// 現在のステレオ出力の有効/無効を返す。内部で
+// AudioDeviceModuleIOS::StereoPlayout() を呼ぶ。
+// setStereoPlayoutEnabled: と同じく、本 ADM を生成したスレッドから呼ぶこと。
+// 別スレッドから呼ぶと内部の RTC_DCHECK_RUN_ON により Debug ビルドが停止する。
+- (BOOL)stereoPlayoutEnabled;
+
 @end
diff --git a/sdk/objc/components/audio/RTCAudioDeviceModule.mm b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
index 30fbcfd655..bc1138f941 100644
--- a/sdk/objc/components/audio/RTCAudioDeviceModule.mm
+++ b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
@@ -41,4 +41,28 @@ - (NSInteger)resumeRecording {
   return ptr->ResumeRecording();
 }
 
+- (NSInteger)setStereoPlayoutEnabled:(BOOL)enabled {
+  // AudioDeviceModuleIOS::SetStereoPlayout は CHECKinitialized_ を通るため、
+  // 事前に ADM を Init() しておく必要がある。PeerConnectionFactory は後段で
+  // 再度 Init() を呼ぶが、AudioDeviceModule::Init は冪等なので問題ない。
+  if (!_adm->Initialized()) {
+    int32_t init_result = _adm->Init();
+    if (init_result != 0) {
+      return init_result;
+    }
+  }
+  return _adm->SetStereoPlayout(enabled);
+}
+
+- (BOOL)stereoPlayoutEnabled {
+  if (!_adm->Initialized()) {
+    return NO;
+  }
+  bool enabled = false;
+  if (_adm->StereoPlayout(&enabled) != 0) {
+    return NO;
+  }
+  return enabled ? YES : NO;
+}
+
 @end
