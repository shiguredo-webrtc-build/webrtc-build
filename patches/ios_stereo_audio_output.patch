+- (void)testConfigurationCanBeChangedBeforeHandoff {
+  RTC_OBJC_TYPE(RTCAudioDeviceModule) *module =
+      [[RTC_OBJC_TYPE(RTCAudioDeviceModule) alloc] init];
+  XCTAssertEqual(0, [module setStereoPlayoutEnabled:YES], @"ステレオを指定できること");
+  XCTAssertEqual(0, [module setStereoPlayoutEnabled:NO], @"受け渡し前は設定を変更できること");
+  XCTAssertFalse([module stereoPlayoutEnabled], @"最後に受け付けた設定を返すこと");
+  auto native = [module nativeAudioDeviceModule];
+  XCTAssertFalse(native->Initialized(), @"設定を変更しても初期化しないこと");
+}
