+// 公開APIで隠している C++ 型のネイティブ ADM ポインタ webrtc::AudioDeviceModule* を安全に取得するためのヘッダ
+// C++ 用の型 webrtc::AudioDeviceModule を扱うため ObjC++ からのみインクルードされる想定
+#import "RTCAudioDeviceModule.h"
+
+#include "api/audio/audio_device.h"
+#include "api/scoped_refptr.h"
+
+@interface RTC_OBJC_TYPE(RTCAudioDeviceModule) ()
+
+// ADM の worker は 1 つの factory が所有するため、受け渡しは 1 回だけ許可する。
+- (webrtc::scoped_refptr<webrtc::AudioDeviceModule>)nativeAudioDeviceModule;
+
+@end
diff --git a/sdk/objc/components/audio/RTCAudioDeviceModule.h b/sdk/objc/components/audio/RTCAudioDeviceModule.h
new file mode 100644
index 0000000000..ec865fc809
--- /dev/null
+++ b/sdk/objc/components/audio/RTCAudioDeviceModule.h
@@ -0,0 +1,20 @@
+// iOS 用の AudioDeviceModule を生成するためのラッパー
+#import <Foundation/Foundation.h>
+
+#import "sdk/objc/base/RTCMacros.h"
+
+RTC_OBJC_EXPORT
+@interface RTC_OBJC_TYPE(RTCAudioDeviceModule) : NSObject
+
+// 内部で AudioDeviceModuleIOS を生成する
+- (instancetype)init;
+// 内部で AudioDeviceModuleIOS を生成する。`enabled` が true の場合は
+// VoiceProcessing のバイパス有効を初期値として生成する。
+// `stereoPlayoutEnabled` が true の場合は iOS 向けステレオ音声出力 (playout) を
+// 有効にして生成する。有効化により playout は VoiceProcessingIO ではなく
+// RemoteIO 経路に切り替わり、iOS の AEC / AGC は使えなくなる。AVAudioSession の
+// mode はステレオ有効時のみ AVAudioSessionModeDefault に一時差し替えされる。
+- (instancetype)initWithBypassVoiceProcessing:(BOOL)enabled
+                         stereoPlayoutEnabled:(BOOL)stereoPlayoutEnabled;
+
+@end
diff --git a/sdk/objc/components/audio/RTCAudioDeviceModule.mm b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
new file mode 100644
index 0000000000..af6adae88e
--- /dev/null
+++ b/sdk/objc/components/audio/RTCAudioDeviceModule.mm
@@ -0,0 +1,40 @@
+#import "RTCAudioDeviceModule+Private.h"
+
+#include "api/environment/environment_factory.h"
+#include "api/scoped_refptr.h"
+#include "sdk/objc/native/api/audio_device_module.h"
+
+@interface RTC_OBJC_TYPE(RTCAudioDeviceModule) () {
+  webrtc::scoped_refptr<webrtc::AudioDeviceModule> _adm;
+  BOOL _nativeAudioDeviceModuleRetrieved;
+}
+@end
+
+@implementation RTC_OBJC_TYPE(RTCAudioDeviceModule)
+
+- (instancetype)init {
+  return [self initWithBypassVoiceProcessing:NO stereoPlayoutEnabled:NO];
+}
+
+- (instancetype)initWithBypassVoiceProcessing:(BOOL)enabled
+                         stereoPlayoutEnabled:(BOOL)stereoPlayoutEnabled {
+  self = [super init];
+  if (self) {
+    auto env = webrtc::CreateEnvironment();
+    _adm = webrtc::CreateAudioDeviceModule(env, enabled, stereoPlayoutEnabled);
+  }
+  return self;
+}
+
+- (webrtc::scoped_refptr<webrtc::AudioDeviceModule>)nativeAudioDeviceModule {
+  @synchronized(self) {
+    if (_nativeAudioDeviceModuleRetrieved) {
+      return nullptr;
+    }
+    // 同じ ADM を複数の factory に渡さない。
+    _nativeAudioDeviceModuleRetrieved = YES;
+    return _adm;
+  }
+}
+
+@end
