+      vpio_unit_, kAUVoiceIOProperty_MuteOutput, kAudioUnitScope_Global,
+      kInputBus, &output_muted, &size);
+  if (result != noErr) {
+    RTCLogError(@"Failed to get microphone output mute state. OSStatus=%ld.", (long)result);
+    return false;
+  }
