--- /dev/null
+++ b/sdk/objc/unittests/RTCManualAudioInput_xctest.mm
@@ -0,0 +1,394 @@
+#import <XCTest/XCTest.h>
+
+#include "api/environment/environment_factory.h"
+#include "modules/audio_device/audio_device_buffer.h"
+#include "rtc_base/thread.h"
+#import "sdk/objc/components/audio/RTCAudioSession+Private.h"
+#import "sdk/objc/components/audio/RTCAudioSessionConfiguration.h"
+#include "sdk/objc/native/src/audio/audio_device_ios.h"
+#include "sdk/objc/native/src/audio/remote_io_audio_unit.h"
+
+namespace webrtc::ios_adm {
+
+// モックを使わず、実際の AudioUnit から入力 I/O の状態を読み戻す。
+class ManualAudioInputTestPeer {
+ public:
+  static bool Uninitialized(const AudioDeviceIOS& device) {
+    return device.audio_unit_ && device.audio_unit_->GetState() == AudioUnitInterface::kUninitialized;
+  }
+  static bool Started(const AudioDeviceIOS& device) {
+    return device.audio_unit_ && device.audio_unit_->GetState() == AudioUnitInterface::kStarted;
+  }
+  static UInt32 InputEnabled(AudioDeviceIOS& device, bool stereo) {
+    if (!device.audio_unit_) return UINT32_MAX;
+    AudioUnit unit = stereo
+        ? static_cast<RemoteIOAudioUnit*>(device.audio_unit_.get())->rio_unit_
+        : static_cast<VoiceProcessingAudioUnit*>(device.audio_unit_.get())->vpio_unit_;
+    UInt32 enabled = UINT32_MAX;
+    UInt32 size = sizeof(enabled);
+    OSStatus status = AudioUnitGetProperty(
+        unit, kAudioOutputUnitProperty_EnableIO, kAudioUnitScope_Input, 1,
+        &enabled, &size);
+    return status == noErr ? enabled : UINT32_MAX;
+  }
+};
+
+}  // namespace webrtc::ios_adm
+
+// 権限を要求せず、再生によって権限の状態が変わらないことを確認する。
+static NSInteger CurrentRecordPermission() {
+  if (@available(iOS 17.0, *)) return [AVAudioApplication sharedInstance].recordPermission;
+  return [AVAudioSession sharedInstance].recordPermission;
+}
+
+@interface RTCManualAudioInputTests : XCTestCase
+@end
+
+@implementation RTCManualAudioInputTests {
+  std::unique_ptr<webrtc::Thread> _worker;
+  std::unique_ptr<webrtc::AudioDeviceBuffer> _buffer;
+  std::unique_ptr<webrtc::ios_adm::AudioDeviceIOS> _device;
+  RTC_OBJC_TYPE(RTCAudioSessionConfiguration)* _configuration;
+  BOOL _manualAudio;
+  BOOL _audioEnabled;
+  int _sessionCount;
+  int _activationCount;
+}
+
+- (void)runOnWorker:(void (^)(void))operation {
+  XCTestExpectation* completed = [[XCTestExpectation alloc] initWithDescription:@"worker 操作が完了すること"];
+  self->_worker->PostTask([operation, completed] {
+    @autoreleasepool {
+      operation();
+      [completed fulfill];
+    }
+  });
+  // メインの run loop を動かし、worker の完了前に tearDown へ進まない。
+  // 待機上限は XCTest の実行タイムアウトで設定し、停止したプロセスごと失敗にする。
+  [self waitForExpectations:@[completed]];
+}
+
+- (void)setUp {
+  [super setUp];
+  self.executionTimeAllowance = 60;
+  _configuration = [RTC_OBJC_TYPE(RTCAudioSessionConfiguration) webRTCConfiguration];
+  RTC_OBJC_TYPE(RTCAudioSession)* session = [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+  _manualAudio = session.useManualAudio;
+  _audioEnabled = session.isAudioEnabled;
+  _sessionCount = session.webRTCSessionCount;
+  _activationCount = session.activationCount;
+  // 音声制御の開始状態を明示し、後の停止通知を実際の状態遷移にする。
+  session.useManualAudio = YES;
+  session.isAudioEnabled = YES;
+  XCTAssertTrue([session setInitialMicrophoneMute:NO], @"初期ミュートを解除できること");
+  self->_worker = webrtc::Thread::Create();
+  XCTAssertTrue(self->_worker->Start(), @"worker を開始できること");
+}
+
+- (void)tearDown {
+  [self runOnWorker:^{
+    self->_device.reset();
+    self->_buffer.reset();
+  }];
+  self->_worker->Stop();
+  RTC_OBJC_TYPE(RTCAudioSession)* session = [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+  XCTAssertEqual(_sessionCount, session.webRTCSessionCount, @"セッション利用数が戻ること");
+  XCTAssertEqual(_activationCount, session.activationCount, @"有効化数が戻ること");
+  [RTC_OBJC_TYPE(RTCAudioSessionConfiguration) setWebRTCConfiguration:_configuration];
+  session.useManualAudio = _manualAudio;
+  session.isAudioEnabled = _audioEnabled;
+  [session setInitialMicrophoneMute:NO];
+  [super tearDown];
+}
+
+- (void)createDeviceWithStereo:(BOOL)stereo input:(BOOL)input {
+  // category の選択はアプリの責務とし、入力を使う場合だけ録音可能にする。
+  RTC_OBJC_TYPE(RTCAudioSessionConfiguration)* config =
+      [[RTC_OBJC_TYPE(RTCAudioSessionConfiguration) alloc] init];
+  config.category = input ? AVAudioSessionCategoryPlayAndRecord : AVAudioSessionCategoryPlayback;
+  config.categoryOptions = input ? AVAudioSessionCategoryOptionDefaultToSpeaker : 0;
+  config.mode = AVAudioSessionModeDefault;
+  [RTC_OBJC_TYPE(RTCAudioSessionConfiguration) setWebRTCConfiguration:config];
+  [self runOnWorker:^{
+    auto env = webrtc::CreateEnvironment();
+    self->_buffer = std::make_unique<webrtc::AudioDeviceBuffer>(env);
+    self->_device = std::make_unique<webrtc::ios_adm::AudioDeviceIOS>(env, false, nullptr, nil);
+    self->_device->AttachAudioBuffer(self->_buffer.get());
+    XCTAssertEqual(webrtc::AudioDeviceGeneric::InitStatus::OK, self->_device->Init(),
+                   @"ADM を初期化できること");
+    XCTAssertEqual(0, self->_device->SetStereoPlayout(stereo), @"出力チャンネル数を設定できること");
+  }];
+}
+
+- (void)checkInputWithStereo:(BOOL)stereo beforeCreation:(BOOL)before muted:(BOOL)muted {
+  [self createDeviceWithStereo:stereo input:YES];
+  RTC_OBJC_TYPE(RTCAudioSession)* session = [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+  XCTAssertTrue([session setInitialMicrophoneMute:muted], @"既存 API で初期ミュートを指定できること");
+  XCTestExpectation* completed = [self expectationWithDescription:@"入力初期化が完了すること"];
+  void (^request)(void) = ^{
+    [session initializeInput:^(NSError* error) {
+      XCTAssertTrue([NSThread isMainThread], @"完了通知はメインキューで受け取ること");
+      XCTAssertNil(error, @"入力初期化が成功すること");
+      [completed fulfill];
+    }];
+  };
+  if (before) request();
+  [self runOnWorker:^{
+    XCTAssertEqual(0, self->_device->InitPlayout(), @"再生を初期化できること");
+    XCTAssertEqual(0, self->_device->StartPlayout(), @"再生を開始できること");
+    // 録音の論理状態だけでは、入力初期化の要求を代用できない。
+    XCTAssertTrue(self->_device->RecordingIsInitialized(), @"再生と共通の録音初期化が済んでいること");
+    XCTAssertEqual(0, self->_device->StartRecording(), @"録音の転送を開始できること");
+    XCTAssertEqual(0u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, stereo),
+                   @"worker が入力要求を処理するまではマイクが無効であること");
+  }];
+  if (!before) request();
+  [self waitForExpectations:@[completed] timeout:10];
+  [self runOnWorker:^{
+    XCTAssertEqual(muted ? 0u : 1u,
+                   webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, stereo),
+                   @"初期ミュートに応じた入力状態であること");
+    XCTAssertTrue(self->_device->Playing(), @"入力追加後も再生が続くこと");
+  }];
+  XCTestExpectation* duplicate = [self expectationWithDescription:@"重複要求を拒否すること"];
+  [session initializeInput:^(NSError* error) {
+    XCTAssertNotNil(error, @"初期化済みの要求はエラーになること");
+    [duplicate fulfill];
+  }];
+  [self waitForExpectations:@[duplicate] timeout:10];
+  // 実際の手動音声停止と再開で再初期化し、入力状態とセッション利用数を検証する。
+  session.useManualAudio = YES;
+  session.isAudioEnabled = NO;
+  [self runOnWorker:^{
+    XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Uninitialized(*self->_device),
+                  @"手動音声停止で AudioUnit が未初期化に戻ること");
+  }];
+  session.isAudioEnabled = YES;
+  [self runOnWorker:^{
+    XCTAssertEqual(muted ? 0u : 1u,
+                   webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, stereo),
+                   @"再初期化で初期ミュートや入力状態を失わないこと");
+    XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                  @"手動音声再開で AudioUnit が再開すること");
+  }];
+}
+
+- (void)testStereoInputBeforeCreation {
+  [self checkInputWithStereo:YES beforeCreation:YES muted:NO];
+}
+- (void)testStereoInputAfterPlaybackStarted {
+  [self checkInputWithStereo:YES beforeCreation:NO muted:NO];
+}
+- (void)testStereoInitiallyMutedInput {
+  [self checkInputWithStereo:YES beforeCreation:NO muted:YES];
+}
+- (void)testMonoInputBeforeCreation {
+  [self checkInputWithStereo:NO beforeCreation:YES muted:NO];
+}
+- (void)testMonoInputAfterPlaybackStarted {
+  [self checkInputWithStereo:NO beforeCreation:NO muted:NO];
+}
+- (void)testMonoInitiallyMutedInput {
+  [self checkInputWithStereo:NO beforeCreation:NO muted:YES];
+}
+
+- (void)testStereoPlaybackWithoutInput {
+  const NSInteger permission = CurrentRecordPermission();
+  [self createDeviceWithStereo:YES input:NO];
+  [self runOnWorker:^{
+    // 同じ ADM の再接続でも、initializeInput なしでは入力を使用しない。
+    for (int iteration = 0; iteration < 2; ++iteration) {
+      XCTAssertEqual(0, self->_device->InitPlayout(), @"再生専用 category で初期化できること");
+      XCTAssertEqual(0, self->_device->StartPlayout(), @"受信専用の再生を開始できること");
+      XCTAssertEqual(0u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, true),
+                     @"マイク入力が無効であること");
+      XCTAssertEqual(-1, self->_device->ResumeRecording(), @"入力未初期化のミュート解除を拒否すること");
+      XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                    @"入力操作を拒否しても再生を停止しないこと");
+      XCTAssertEqual(0, self->_device->StopPlayout(), @"再生を停止できること");
+    }
+  }];
+  XCTAssertEqual(permission, CurrentRecordPermission(), @"受信専用の再生はマイク権限を変更しないこと");
+}
+
+- (void)testStereoHardMuteKeepsPlayback {
+  [self createDeviceWithStereo:YES input:YES];
+  [self runOnWorker:^{
+    XCTAssertEqual(0, self->_device->InitPlayout(), @"ステレオ再生を初期化できること");
+    XCTAssertEqual(0, self->_device->StartPlayout(), @"ステレオ再生を開始できること");
+    XCTAssertEqual(0, self->_device->StartRecording(), @"録音の転送を開始できること");
+  }];
+  XCTestExpectation* completed = [self expectationWithDescription:@"ミュート前に入力を初期化すること"];
+  [[RTC_OBJC_TYPE(RTCAudioSession) sharedInstance] initializeInput:^(NSError* error) {
+    XCTAssertNil(error, @"入力初期化が成功すること");
+    [completed fulfill];
+  }];
+  [self waitForExpectations:@[completed] timeout:10];
+  [self runOnWorker:^{
+    // 実際の pause / resume に伴う再初期化後の入力 I/O と開始状態を確認する。
+    for (bool mute : {true, false, true, false}) {
+      XCTAssertEqual(0, mute ? self->_device->PauseRecording() : self->_device->ResumeRecording(),
+                     @"ハードミュートを切り替えられること");
+      XCTAssertEqual(mute ? 0u : 1u,
+                     webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, true),
+                     @"再初期化後も入力 I/O がミュートに従うこと");
+      XCTAssertEqual(!mute, self->_device->Recording(), @"録音の転送状態がミュートに従うこと");
+      XCTAssertTrue(self->_device->Playing(), @"ミュート中も再生の論理状態を維持すること");
+      XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                    @"ミュートの切り替え後に AudioUnit が再開すること");
+    }
+  }];
+}
+
+- (void)checkInitiallyMutedResumeWithStereo:(BOOL)stereo {
+  [self createDeviceWithStereo:stereo input:YES];
+  RTC_OBJC_TYPE(RTCAudioSession)* session = [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+  XCTAssertTrue([session setInitialMicrophoneMute:YES], @"初期状態をミュートにできること");
+  [self runOnWorker:^{
+    XCTAssertEqual(0, self->_device->InitPlayout(), @"再生を初期化できること");
+    XCTAssertEqual(0, self->_device->StartPlayout(), @"再生を開始できること");
+    XCTAssertEqual(0, self->_device->StartRecording(), @"録音の転送を開始できること");
+  }];
+  XCTestExpectation* completed = [self expectationWithDescription:@"初期ミュートで入力を初期化すること"];
+  [session initializeInput:^(NSError* error) {
+    XCTAssertNil(error, @"入力初期化が成功すること");
+    [completed fulfill];
+  }];
+  [self waitForExpectations:@[completed] timeout:10];
+  [self runOnWorker:^{
+    // 初期ミュートでは録音の論理状態と入力 I/O が異なるため、pause を挟まず解除する。
+    XCTAssertTrue(self->_device->Recording(), @"録音の論理状態は開始済みであること");
+    XCTAssertEqual(0u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, stereo),
+                   @"初期ミュートでは入力 I/O が無効であること");
+    for (int attempt = 0; attempt < 2; ++attempt) {
+      XCTAssertEqual(0, self->_device->ResumeRecording(), @"最初の解除と同じ要求の繰り返しが成功すること");
+      XCTAssertEqual(1u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, stereo),
+                     @"解除要求を省略せず入力 I/O を有効にすること");
+      XCTAssertTrue(self->_device->Recording(), @"解除後も録音の転送を継続すること");
+      XCTAssertTrue(self->_device->Playing(), @"解除後も再生を継続すること");
+      XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                    @"解除後に AudioUnit が開始していること");
+    }
+  }];
+}
+
+- (void)testStereoInitiallyMutedInputCanResume {
+  [self checkInitiallyMutedResumeWithStereo:YES];
+  RTC_OBJC_TYPE(RTCAudioSession)* session = [RTC_OBJC_TYPE(RTCAudioSession) sharedInstance];
+  [self runOnWorker:^{
+    // 同じ worker 内で変更し、非同期の停止通知が届く前に切り替える順序も検証する。
+    session.isAudioEnabled = NO;
+    // 手動停止中の切り替えでは、入力状態だけ変え、AudioUnit を起動しない。
+    XCTAssertEqual(0, self->_device->PauseRecording(), @"手動停止中もミュートを設定できること");
+    XCTAssertEqual(0, self->_device->ResumeRecording(), @"手動停止中も解除を設定できること");
+    XCTAssertEqual(1u, webrtc::ios_adm::ManualAudioInputTestPeer::InputEnabled(*self->_device, true),
+                   @"次回の再開に向けて入力 I/O が有効になっていること");
+    XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Uninitialized(*self->_device),
+                  @"ミュート切り替えで手動音声停止を解除しないこと");
+    XCTAssertEqual(self->_activationCount, session.activationCount,
+                   @"停止通知を先取りしてもセッションの有効化を残さないこと");
+  }];
+  session.isAudioEnabled = YES;
+  [self runOnWorker:^{
+    XCTAssertTrue(webrtc::ios_adm::ManualAudioInputTestPeer::Started(*self->_device),
+                  @"手動音声再開の通知で AudioUnit が開始すること");
+  }];
+}
+
+- (void)testMonoInitiallyMutedInputCanResume {
+  [self checkInitiallyMutedResumeWithStereo:NO];
+}
