+#ifndef SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
+#define SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
+
+#include <AudioUnit/AudioUnit.h>
+
+#include "audio_unit_interface.h"
+#include "voice_processing_audio_unit.h"
+
+namespace webrtc {
+namespace ios_adm {
+
+// AudioUnitInterface の RemoteIO 実装。
+// VoiceProcessingIO ではステレオ playout が事実上成立しないため、
+// ステレオ出力有効時のみ AudioDeviceIOS がこの実装を選択する。
+// AudioUnit インスタンス、状態、コールバック配線を自前で持つ。
+// AEC / AGC は VoiceProcessingIO 固有機能であり RemoteIO 使用時は失われる。
+class RemoteIOAudioUnit : public AudioUnitInterface {
+ public:
+  // playout / record のチャンネル数はコンストラクタで固定する。
+  // observer は既存 VoiceProcessingAudioUnitObserver 型を流用する
+  // (OnGetPlayoutData / OnDeliverRecordedData の通知経路を統一するため)。
+  RemoteIOAudioUnit(VoiceProcessingAudioUnitObserver* observer,
+                    UInt32 play_channels,
+                    UInt32 rec_channels);
+  ~RemoteIOAudioUnit() override;
+
+  // AudioUnit を生成して入出力バスとコールバックを配線する。
+  bool Init() override;
+
+  State GetState() const override;
+
+  // 与えられたサンプルレートでストリームフォーマットを設定して
+  // AudioUnit を初期化する。
+  bool Initialize(Float64 sample_rate) override;
+
+  // AudioUnit を開始する。
+  OSStatus Start() override;
+
+  // AudioUnit を停止する。
+  bool Stop() override;
+
+  // AudioUnit の初期化を解除する。
+  bool Uninitialize() override;
+
+  // RemoteIO には VoiceProcessing 固有のマイクミュート機構は無い。
+  // interface 実装上の存在意義のためだけに残す。
+  bool SetMicrophoneMute(bool enable) override;
+
+  // 入力バス側の AudioUnitRender を呼ぶ。
+  OSStatus Render(AudioUnitRenderActionFlags* flags,
+                  const AudioTimeStamp* time_stamp,
+                  UInt32 output_bus_number,
+                  UInt32 num_frames,
+                  AudioBufferList* io_data) override;
+
+ private:
+  // Core Audio の C API は static コールバックを要求するため、
+  // in_ref_con をこのクラスのポインタに戻して instance method へ橋渡しする。
+  static OSStatus OnGetPlayoutData(void* in_ref_con,
+                                   AudioUnitRenderActionFlags* flags,
+                                   const AudioTimeStamp* time_stamp,
+                                   UInt32 bus_number,
+                                   UInt32 num_frames,
+                                   AudioBufferList* io_data);
+  static OSStatus OnDeliverRecordedData(void* in_ref_con,
+                                        AudioUnitRenderActionFlags* flags,
+                                        const AudioTimeStamp* time_stamp,
+                                        UInt32 bus_number,
+                                        UInt32 num_frames,
+                                        AudioBufferList* io_data);
+
+  // observer への通知ヘルパ。
+  OSStatus NotifyGetPlayoutData(AudioUnitRenderActionFlags* flags,
+                                const AudioTimeStamp* time_stamp,
+                                UInt32 bus_number,
+                                UInt32 num_frames,
+                                AudioBufferList* io_data);
+  OSStatus NotifyDeliverRecordedData(AudioUnitRenderActionFlags* flags,
+                                     const AudioTimeStamp* time_stamp,
+                                     UInt32 bus_number,
+                                     UInt32 num_frames,
+                                     AudioBufferList* io_data);
+
+  // チャンネル数を引数で受ける GetFormat。playout / record で異なる
+  // チャンネル数 (2ch playout + 1ch record など) を扱えるようにする。
+  AudioStreamBasicDescription GetFormat(Float64 sample_rate,
+                                        UInt32 channels) const;
+
+  // AudioUnit インスタンスの破棄。
+  void DisposeAudioUnit();
+
+  VoiceProcessingAudioUnitObserver* observer_;
+  const UInt32 play_channels_;
+  const UInt32 rec_channels_;
+  AudioUnit rio_unit_;
+  State state_;
+};
+
+}  // namespace ios_adm
+}  // namespace webrtc
+
+#endif  // SDK_OBJC_NATIVE_SRC_AUDIO_REMOTE_IO_AUDIO_UNIT_H_
