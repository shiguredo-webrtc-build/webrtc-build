+- (void)checkDeferredInitializationWithStereo:(BOOL)enabled {
+  // WebRTC に登録されていないアプリ側スレッドを再現する。
+  // このスレッドで AudioDeviceIOS を生成すると thread_ が nullptr になる。
+  std::thread caller([&] {
+    @autoreleasepool {
+      XCTAssertTrue(webrtc::Thread::Current() == nullptr,
+                    @"呼び出し元は WebRTC のスレッドではないこと");
+      RTC_OBJC_TYPE(RTCAudioDeviceModule) *module =
+          [[RTC_OBJC_TYPE(RTCAudioDeviceModule) alloc]
+              initWithBypassVoiceProcessing:NO
+                       stereoPlayoutEnabled:enabled];
+
+      // factory と同じ経路で ADM を受け取り、構築だけでは初期化されないことを調べる。
+      auto native = [module nativeAudioDeviceModule];
+      XCTAssertTrue([module nativeAudioDeviceModule] == nullptr,
+                    @"同じ ADM を複数の worker に渡さないこと");
+      XCTAssertFalse(native->Initialized(), @"アプリ側では ADM を初期化しないこと");
+
+      auto worker = webrtc::Thread::Create();
+      const bool started = worker->Start();
+      XCTAssertTrue(started, @"worker スレッドを開始できること");
+      if (!started) {
+        return;
+      }
+      worker->BlockingCall([&] {
+        // 実際の ADM を worker スレッドで初期化する。スレッド制約の DCHECK も検証する。
+        const int result = native->Init();
+        XCTAssertEqual(0, result, @"worker スレッドで初期化できること");
+        if (result != 0) {
+          return;
+        }
+        bool stereo = false;
+        XCTAssertEqual(0, native->StereoPlayout(&stereo), @"設定が反映されていること");
+        XCTAssertEqual(static_cast<bool>(enabled), stereo, @"設定したチャンネル数を使うこと");
+        webrtc::AudioParameters parameters;
+        XCTAssertEqual(0, native->GetPlayoutAudioParameters(&parameters),
+                       @"実際の再生パラメーターを取得できること");
+        XCTAssertEqual(enabled ? 2u : 1u, parameters.channels(),
+                       @"再生パラメーターにも設定が反映されること");
+      });
+
+      worker->BlockingCall([&] {
+        XCTAssertEqual(0, native->Terminate(), @"終了できること");
+        webrtc::AudioParameters parameters;
+        webrtc::AudioDeviceModule::AudioLayer layer;
+        XCTAssertEqual(-1, native->ActiveAudioLayer(&layer), @"終了後のデバイス参照を拒否すること");
+        XCTAssertEqual(-1, native->RegisterAudioCallback(nullptr), @"終了後のバッファ参照を拒否すること");
+        XCTAssertEqual(-1, native->GetPlayoutAudioParameters(&parameters), @"終了後の再生設定取得を拒否すること");
+        XCTAssertEqual(-1, native->GetRecordAudioParameters(&parameters), @"終了後の録音設定取得を拒否すること");
+        XCTAssertEqual(0, native->Init(), @"再初期化できること");
+        bool stereo = false;
+        XCTAssertEqual(0, native->StereoPlayout(&stereo), @"再初期化後の設定を取得できること");
+        XCTAssertEqual(static_cast<bool>(enabled), stereo, @"再初期化でも設定を保持すること");
+        XCTAssertEqual(0, native->Terminate(), @"再初期化後も終了できること");
+      });
+      worker->Stop();
+      // ネイティブ ADM の終了時に worker 専用リソースを破棄済みなので、
+      // ObjC ラッパーの最後の参照はアプリ側で安全に解放できる。
+      XCTAssertEqual(-1, [module resumeRecording], @"実行先がない解除要求を拒否すること");
+      module = nil;
+      native = nullptr;
+    }
+  });
+  caller.join();
+}
+
+- (void)testStereoInitializationIsDeferred {
+  [self checkDeferredInitializationWithStereo:YES];
+}
+
+- (void)testDefaultMonoInitializationIsDeferred {
+  [self checkDeferredInitializationWithStereo:NO];
+}
+
+- (void)testRemoteIOMicrophoneMutePreservesOutputIO {
+  auto worker = webrtc::Thread::Create();
+  const bool started = worker->Start();
+  XCTAssertTrue(started, @"worker スレッドを開始できること");
+  if (!started) {
+    return;
+  }
+  worker->BlockingCall([&] {
+    // 実際の AudioDeviceIOS を observer として使う。I/O は開始せず、
+    // 未初期化状態での EnableIO の読み戻しを検証する。モックは使用しない。
+    webrtc::ios_adm::AudioDeviceIOS observer(
+        webrtc::CreateEnvironment(), false, nullptr, nullptr);
+    webrtc::ios_adm::RemoteIOAudioUnit unit(&observer, 2, 1);
+    const bool initialized = unit.Init();
+    XCTAssertTrue(initialized, @"実際の RemoteIO を生成できること");
+    if (!initialized) {
+      return;
+    }
+    AudioUnit native = webrtc::ios_adm::RemoteIOAudioUnitTestPeer::GetAudioUnit(unit);
+    const auto check_io = [&](UInt32 expected_input) {
+      UInt32 input = 0;
+      UInt32 size = sizeof(input);
+      XCTAssertEqual(noErr, AudioUnitGetProperty(native, kAudioOutputUnitProperty_EnableIO,
+                                               kAudioUnitScope_Input, 1, &input, &size),
+                     @"入力 bus の EnableIO を取得できること");
+      XCTAssertEqual(expected_input, input, @"入力 I/O が要求どおりに設定されること");
+      UInt32 output = 0;
+      size = sizeof(output);
+      XCTAssertEqual(noErr, AudioUnitGetProperty(native, kAudioOutputUnitProperty_EnableIO,
+                                               kAudioUnitScope_Output, 0, &output, &size),
+                     @"出力 bus の EnableIO を取得できること");
+      XCTAssertEqual(1u, output, @"ミュート状態にかかわらず出力 I/O が有効なこと");
+    };
+    check_io(0);
+    bool muted = false;
+    XCTAssertFalse(unit.GetMicrophoneMute(muted), @"入力未初期化の状態取得を拒否すること");
+    XCTAssertFalse(unit.SetMicrophoneMute(false), @"入力未初期化のミュート解除を拒否すること");
+    check_io(0);
+    XCTAssertTrue(unit.InitializeInput(false), @"入力要求に従って入力を初期化できること");
+    check_io(1);
+    // 同じ要求の繰り返しと再切り替えの両方を確認し、no-op への退行を検出する。
+    for (bool mute : {true, true, false, false, true, false}) {
+      XCTAssertTrue(unit.SetMicrophoneMute(mute), @"ミュートの設定に成功すること");
+      check_io(mute ? 0 : 1);
+      XCTAssertTrue(unit.GetMicrophoneMute(muted), @"実際のミュート状態を取得できること");
+      XCTAssertEqual(mute, muted, @"入力 I/O と取得したミュート状態が一致すること");
+    }
+    // マイク捕捉、再初期化後の再生、インジケーターは別途実機で検証する。
+  });
+  worker->Stop();
+}
+
+- (void)checkInitiallyMutedUnitWithStereo:(BOOL)stereo detectMutedSpeech:(BOOL)detect {
+  auto worker = webrtc::Thread::Create();
+  XCTAssertTrue(worker->Start(), @"worker を開始できること");
+  worker->BlockingCall([&] {
+    // 実際の AudioUnit を使用し、音声サーバーの起動とは独立して初期ミュート解除を検証する。
+    webrtc::ios_adm::AudioDeviceIOS observer(webrtc::CreateEnvironment(), false, nullptr, nullptr);
+    std::unique_ptr<webrtc::ios_adm::AudioUnitInterface> unit;
+    if (stereo) {
+      unit = std::make_unique<webrtc::ios_adm::RemoteIOAudioUnit>(&observer, 2, 1);
+    } else {
+      unit = std::make_unique<webrtc::ios_adm::VoiceProcessingAudioUnit>(false, detect, &observer);
+    }
+    XCTAssertTrue(unit->Init(), @"AudioUnit を生成できること");
+    XCTAssertTrue(unit->InitializeInput(true), @"初期ミュートで入力を準備できること");
+    bool muted = false;
+    XCTAssertTrue(unit->GetMicrophoneMute(muted), @"初期ミュート状態を取得できること");
+    XCTAssertTrue(muted, @"入力 I/O が無効な初期状態をミュートとして扱うこと");
+    // AudioUnitInitialize は呼ばず、初期状態の EnableIO によるミュートと解除を検証する。
+    // 音声検出を伴う稼働中のミュートは実際の入出力を開始する検証で扱う。
+    for (bool requested : {false, false}) {
+      XCTAssertTrue(unit->SetMicrophoneMute(requested), @"初期ミュート解除と同じ要求の繰り返しが成功すること");
+      XCTAssertTrue(unit->GetMicrophoneMute(muted), @"切り替え後の実際のミュート状態を取得できること");
+      XCTAssertEqual(requested, muted, @"録音フラグに依存せず実際のミュート状態を返すこと");
+    }
+  });
+  worker->Stop();
+}
+
+- (void)testInitiallyMutedRemoteIOCanUnmute {
+  [self checkInitiallyMutedUnitWithStereo:YES detectMutedSpeech:NO];
+}
+
+- (void)testInitiallyMutedVoiceProcessingCanUnmute {
+  [self checkInitiallyMutedUnitWithStereo:NO detectMutedSpeech:NO];
+}
+
+- (void)testInitiallyMutedVoiceProcessingWithSpeechDetectionCanUnmute {
+  [self checkInitiallyMutedUnitWithStereo:NO detectMutedSpeech:YES];
+}
+
+@end
